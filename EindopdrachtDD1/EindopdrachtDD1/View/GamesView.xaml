<UserControl x:Class="EindopdrachtDD1.View.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EindopdrachtDD1.View"
             xmlns:viewmodels="clr-namespace:EindopdrachtDD1.ViewModel"
             xmlns:view="csr-namespace:EindopdrachtDD1.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <d:Window.DataContext>
            <viewmodels:GamesViewModel/>
        </d:Window.DataContext>

        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" CanUserAddRows="False" 
                  VerticalAlignment="Top" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource
                                AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="Delete"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Name:"/>
                <TextBox Text="{Binding Game.Name}" Width="150"/>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Genre:"/>
                <ComboBox Text="{Binding Game.Genre}" Width="150" SelectedIndex="0">
                    <ComboBoxItem Content="Action"/>
                    <ComboBoxItem Content="Adventure"/>
                    <ComboBoxItem Content="MMORPG"/>
                    <ComboBoxItem Content="Survival"/>
                    <ComboBoxItem Content="Puzzle"/>
                </ComboBox>
            </StackPanel>
            <Button Command="{Binding AddGameCommand}" Content="Add"/>
            <Button Command="{Binding UpdateGameCommand}" Content="Edit"/>
        </StackPanel>
    </Grid>
</UserControl>
