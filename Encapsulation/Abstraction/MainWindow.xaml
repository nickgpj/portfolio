<Window x:Class="Abstraction.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Abstraction"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="DodgerBlue"/>
                <GradientStop Color="Black" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Margin="150,0,0,0">
            <TextBlock FontSize="12" Text="Kenteken" Foreground="White"/>
            <TextBlock x:Name="tblKenteken" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Merk:" Foreground="White"/>
            <TextBlock x:Name="tblMerk" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Model:" Foreground="White"/>
            <TextBlock x:Name="tblModel" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="KmStand:" Foreground="White"/>
            <TextBlock x:Name="tblKmStand" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Bouwjaar:" Foreground="White"/>
            <TextBlock x:Name="tblBouwjaar" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Leeftijd:" Foreground="White"/>
            <TextBlock x:Name="tblLeeftijd" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Kilometers per Liter:" Foreground="White"/>
            <TextBlock x:Name="tblKmPerLiter" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Liters in Tank:" Foreground="White"/>
            <TextBlock x:Name="tblLitersInTank" FontSize="18" Foreground="White"/>

            <TextBlock FontSize="12" Text="Max Tankinhoud:" Foreground="White"/>
            <TextBlock x:Name="tblMaxTankinhoud" FontSize="18" Foreground="White"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="btTanken" Content="Tanken" Margin="0,0,10,0" Click="btTanken_Click"/>
                <Button x:Name="btRijden" Content="Rijden" Click="btRijden_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
